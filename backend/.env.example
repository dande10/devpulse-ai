DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/devpulse
TAVILY_API_KEY=
CORS_ORIGINS=http://localhost:5173
TAVILY_MAX_RESULTS=10

# Optional. Feedback and technology-request submissions are stored either
# way; set all five of these to also get an email notification for each one.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
NOTIFY_EMAIL=

# Required to use any /api/admin/* route (feedback approval, technology
# request status, manual refresh, ingestion history). Generate one with:
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as the X-Admin-Token header on those requests.
ADMIN_TOKEN=
